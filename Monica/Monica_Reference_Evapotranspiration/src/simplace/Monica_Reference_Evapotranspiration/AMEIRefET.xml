<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration PUBLIC "-//SIMPLACE/DTD GRP 1.0//EN" "http://simplace.net/dtd/GroupComponent.dtd">
<configuration class="net.simplace.sim.components.Monica_Reference_Evapotranspiration.AMEIRefET">
    <simgroup>
        <simcomponent id="ReferenceEvapotranspiration" class="net.simplace.sim.components.Monica_Reference_Evapotranspiration.ReferenceEvapotranspiration">
            <input id="height_nn" source="AMEIRefET.height_nn"/>
            <input id="latent_heat_of_vaporization" source="AMEIRefET.latent_heat_of_vaporization"/>
            <input id="mean_air_temperature" source="AMEIRefET.mean_air_temperature"/>
            <input id="wind_speed" source="AMEIRefET.wind_speed"/>
            <input id="wind_speed_height" source="AMEIRefET.wind_speed_height"/>
            <input id="stomata_resistance" source="AMEIRefET.stomata_resistance"/>
            <input id="net_radiation" source="AMEIRefET.net_radiation"/>
            <input id="saturation_vapor_pressure_deficit" source="AMEIRefET.saturation_vapor_pressure_deficit"/>
            <input id="saturated_vapor_pressure_slope" source="AMEIRefET.saturated_vapor_pressure_slope"/>
            <input id="psychrometric_constant" source="AMEIRefET.psychrometric_constant"/>
            <output id="reference_evapotranspiration" destination="AMEIRefET.reference_evapotranspiration"/></simcomponent></simgroup></configuration>