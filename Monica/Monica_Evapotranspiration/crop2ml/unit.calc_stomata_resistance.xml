<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE ModelUnit PUBLIC " "
        "https://raw.githubusercontent.com/AgriculturalModelExchangeInitiative/crop2ml/master/ModelUnit.dtd">
<ModelUnit modelid="Monica_Evapotranspiration.CalcStomataResistance"
           name="CalcStomataResistance"
           timestep="1" version="1">
    <Description>
        <Title>If Else unit </Title>
        <Authors>Michael Berg-Mohnicke</Authors>
        <Institution>ZALF e.V.</Institution>
        <URI></URI>
        <Reference></Reference>
        <ExtendedDescription></ExtendedDescription>
        <ShortDescription>switches between two input values </ShortDescription>
    </Description>
    <Inputs>
        <!-- auxiliary -->
        <Input name="calc_stomata_resistance" description="boolean condition to be met"
               inputtype="variable" variablecategory="auxiliary"
               datatype="BOOLEAN" default="false" unit=""/>
        <Input name="calculated_stomata_resistance" description="value to be returned if condition is true"
               inputtype="variable" variablecategory="auxiliary"
               datatype="DOUBLE" max="10000" min="0" default="100" unit="s/m"/>
        <Input name="fixed_stomata_resistance" description="value to be returned if condition is false"
               inputtype="variable" variablecategory="auxiliary"
               datatype="DOUBLE" max="10000" min="0" default="100" unit="s/m"/>
    </Inputs>
    <Outputs>
        <Output name="stomata_resistance" description="the output value"
                variablecategory="auxiliary"
                datatype="DOUBLE" max="10000" min="0" unit="s/m"/>
    </Outputs>
    <!-- if there is no state, there is no need for an initialization function -->
<!--    <Initialization name="init_potential_evapotranspiration" language="cyml"-->
<!--                    filename="algo/pyx/init_potential_evapotranspiration.pyx"/>-->
    <Algorithm language="cyml" platform=""
               filename="algo/pyx/calc_stomata_resistance.pyx"/>
    <Parametersets/>
    <Testsets/>
</ModelUnit>