<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration PUBLIC "-//SIMPLACE/DTD GRP 1.0//EN" "http://simplace.net/dtd/GroupComponent.dtd">
<configuration class="net.simplace.sim.components.Monica_Evapotranspiration.ET">
    <simgroup>
        <simcomponent id="Radiation" class="net.simplace.sim.components.Monica_Evapotranspiration.Radiation">
            <input id="latitude" source="ET.latitude"/>
            <input id="global_radiation" source="ET.global_radiation"/>
            <input id="julian_day" source="ET.julian_day"/>
            <input id="sunshine_hours" source="ET.sunshine_hours"/>
            <output id="declination" destination="ET.declination"/>
            <output id="astronomic_daylength" destination="ET.astronomic_daylength"/>
            <output id="effective_daylength" destination="ET.effective_daylength"/>
            <output id="photoperiodic_daylength" destination="ET.photoperiodic_daylength"/>
            <output id="sunshine_hours_global_radiation" destination="ET.sunshine_hours_global_radiation"/>
            <output id="extraterrestrial_radiation" destination="ET.extraterrestrial_radiation"/>
            <output id="clear_day_radiation" destination="ET.clear_day_radiation"/>
            <output id="overcast_day_radiation" destination="ET.overcast_day_radiation"/>
            <output id="phot_act_radiation_mean" destination="ET.phot_act_radiation_mean"/></simcomponent>
        <simcomponent id="SaturatedVaporPressure" class="net.simplace.sim.components.Monica_Evapotranspiration.SaturatedVaporPressure">
            <input id="max_air_temperature" source="ET.max_air_temperature"/>
            <input id="min_air_temperature" source="ET.min_air_temperature"/>
            <input id="relative_humidity" source="ET.relative_humidity"/></simcomponent>
        <simcomponent id="UseExtVaporPressure" class="net.simplace.sim.components.Monica_Evapotranspiration.UseExtVaporPressure">
            <input id="use_external_vapor_pressure" source="ET.use_external_vapor_pressure"/>
            <input id="external_vapor_pressure" source="ET.external_vapor_pressure"/>
            <input id="internal_vapor_pressure" source="SaturatedVaporPressure.vapor_pressure"/></simcomponent>
        <simcomponent id="NetRadiation" class="net.simplace.sim.components.Monica_Evapotranspiration.NetRadiation">
            <input id="reference_albedo" source="ET.reference_albedo"/>
            <input id="height_nn" source="ET.height_nn"/>
            <input id="max_air_temperature" source="ET.max_air_temperature"/>
            <input id="min_air_temperature" source="ET.min_air_temperature"/>
            <input id="global_radiation" source="ET.global_radiation"/>
            <input id="extraterrestrial_radiation" source="Radiation.extraterrestrial_radiation"/>
            <input id="vapor_pressure" source="UseExtVaporPressure.vapor_pressure"/></simcomponent>
        <simcomponent id="SaturationVaporPressureDeficit" class="net.simplace.sim.components.Monica_Evapotranspiration.SaturationVaporPressureDeficit">
            <input id="saturated_vapor_pressure" source="SaturatedVaporPressure.saturated_vapor_pressure"/>
            <input id="vapor_pressure" source="UseExtVaporPressure.vapor_pressure"/></simcomponent>
        <simcomponent id="StomataResistance" class="net.simplace.sim.components.Monica_Evapotranspiration.StomataResistance">
            <input id="saturation_beta" source="ET.saturation_beta"/>
            <input id="stomata_conductance_alpha" source="ET.stomata_conductance_alpha"/>
            <input id="carboxylation_pathway" source="ET.carboxylation_pathway"/>
            <input id="gross_photosynthesis_reference_mol" source="ET.gross_photosynthesis_reference_mol"/>
            <input id="atmospheric_co2_concentration" source="ET.atmospheric_co2_concentration"/>
            <input id="saturation_vapor_pressure_deficit" source="SaturationVaporPressureDeficit.saturation_vapor_pressure_deficit"/></simcomponent>
        <simcomponent id="CalcStomataResistance" class="net.simplace.sim.components.Monica_Evapotranspiration.CalcStomataResistance">
            <input id="calc_stomata_resistance" source="ET.calc_stomata_resistance"/>
            <input id="fixed_stomata_resistance" source="ET.fixed_stomata_resistance"/>
            <input id="calculated_stomata_resistance" source="StomataResistance.stomata_resistance"/></simcomponent>
        <simcomponent id="ReferenceEvapotranspiration" class="net.simplace.sim.components.Monica_Evapotranspiration.ReferenceEvapotranspiration">
            <input id="height_nn" source="ET.height_nn"/>
            <input id="mean_air_temperature" source="ET.mean_air_temperature"/>
            <input id="wind_speed" source="ET.wind_speed"/>
            <input id="wind_speed_height" source="ET.wind_speed_height"/>
            <input id="stomata_resistance" source="ET.stomata_resistance"/>
            <input id="net_radiation" source="ET.net_radiation"/>
            <input id="stomata_resistance" source="CalcStomataResistance.stomata_resistance"/>
            <input id="net_radiation" source="NetRadiation.net_radiation"/>
            <output id="reference_evapotranspiration" destination="ET.reference_evapotranspiration"/></simcomponent>
        <simcomponent id="UseExtET0" class="net.simplace.sim.components.Monica_Evapotranspiration.UseExtET0">
            <input id="use_external_et0" source="ET.use_external_et0"/>
            <input id="external_et0" source="ET.external_et0"/>
            <input id="internal_et0" source="ReferenceEvapotranspiration.reference_evapotranspiration"/></simcomponent>
        <simcomponent id="PotentialEvapotranspiration" class="net.simplace.sim.components.Monica_Evapotranspiration.PotentialEvapotranspiration">
            <input id="kc_factor" source="ET.kc_factor"/>
            <input id="developmental_stage" source="ET.developmental_stage"/>
            <input id="crop_remaining_evapotranspiration" source="ET.crop_remaining_evapotranspiration"/>
            <input id="reference_evapotranspiration" source="UseExtET0.et0"/>
            <output id="potential_evapotranspiration" destination="ET.potential_evapotranspiration"/></simcomponent>
        <simcomponent id="Evapotranspiration" class="net.simplace.sim.components.Monica_Evapotranspiration.Evapotranspiration">
            <input id="evaporation_zeta" source="ET.evaporation_zeta"/>
            <input id="maximum_evaporation_impact_depth" source="ET.maximum_evaporation_impact_depth"/>
            <input id="evaporation_reduction_method" source="ET.evaporation_reduction_method"/>
            <input id="xsa_critical_soil_moisture" source="ET.xsa_critical_soil_moisture"/>
            <input id="no_of_soil_layers" source="ET.no_of_soil_layers"/>
            <input id="no_of_soil_moisture_layers" source="ET.no_of_soil_moisture_layers"/>
            <input id="layer_thickness" source="ET.layer_thickness"/>
            <input id="permanent_wilting_point" source="ET.permanent_wilting_point"/>
            <input id="field_capacity" source="ET.field_capacity"/>
            <input id="kc_factor" source="ET.kc_factor"/>
            <input id="has_snow_cover" source="ET.has_snow_cover"/>
            <input id="developmental_stage" source="ET.developmental_stage"/>
            <input id="crop_transpiration" source="ET.crop_transpiration"/>
            <input id="crop_evaporated_from_intercepted" source="ET.crop_evaporated_from_intercepted"/>
            <input id="percentage_soil_coverage" source="ET.percentage_soil_coverage"/>
            <input id="surface_water_storage" source="ET.surface_water_storage"/>
            <input id="evaporated_from_surface" source="ET.evaporated_from_surface"/>
            <input id="actual_evaporation" source="ET.actual_evaporation"/>
            <input id="actual_transpiration" source="ET.actual_transpiration"/>
            <input id="soil_moisture" source="ET.soil_moisture"/>
            <input id="evaporation" source="ET.evaporation"/>
            <input id="transpiration" source="ET.transpiration"/>
            <input id="evapotranspiration" source="ET.evapotranspiration"/>
            <input id="actual_evapotranspiration" source="ET.actual_evapotranspiration"/>
            <input id="potential_evapotranspiration" source="PotentialEvapotranspiration.potential_evapotranspiration"/></simcomponent></simgroup></configuration>