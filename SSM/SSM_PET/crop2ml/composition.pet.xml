<?xml version="1.0" ?>
<ModelComposition name="pet" id="SSM.pet" version="0.1" timestep="1">
	<Description>
		<Title>SSM Evapotranspiration</Title>
		<Authors>Thomas Sinclair, </Authors>
		<Institution>CIRAD</Institution>
		<Reference/>
		<ExtendedDescription>PotentialEvapotranspiration — simplified Penman-style PET (EEQ from srad, tmax, tmin with albedo and Tmax adjustments; cites Sultani and Sinclair 2012)</ExtendedDescription>
		<ShortDescription>Simplified Penman PET.</ShortDescription>
	</Description>
	<Composition>
		<Model name="PotentialEvapotranspiration" id="SSM.PotentialEvapotranspiration" filename="unit.PotentialEvapotranspiration.xml"/>
		<Links>
			<InputLink target="PotentialEvapotranspiration.tmax" source="tmax"/>
			<InputLink target="PotentialEvapotranspiration.tmin" source="tmin"/>
			<InputLink target="PotentialEvapotranspiration.srad" source="srad"/>
			<InputLink target="PotentialEvapotranspiration.albedo" source="albedo"/>
			<OutputLink target="pet" source="PotentialEvapotranspiration.pet"/>
		</Links>
	</Composition>
</ModelComposition>
