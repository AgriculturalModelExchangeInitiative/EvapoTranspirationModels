<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration PUBLIC "-//SIMPLACE/DTD GRP 1.0//EN" "http://simplace.net/dtd/GroupComponent.dtd">
<configuration class="net.simplace.sim.components.SiriusQuality-EnergyBalance_Original.EnergyBalanceComposite">
    <simgroup>
        <simcomponent id="NetRadiation" class="net.simplace.sim.components.SiriusQuality-EnergyBalance_Original.NetRadiation">
            <input id="albedoCoefficient" source="EnergyBalanceComposite.albedoCoefficient"/>
            <input id="maxTair" source="EnergyBalanceComposite.maxTair"/>
            <input id="minTair" source="EnergyBalanceComposite.minTair"/>
            <input id="vaporPressure" source="EnergyBalanceComposite.vaporPressure"/>
            <input id="ih" source="EnergyBalanceComposite.ih"/>
            <input id="extraSolarRadiation" source="EnergyBalanceComposite.extraSolarRadiation"/>
            <input id="solarRadiation" source="EnergyBalanceComposite.solarRadiation"/>
            <input id="tau" source="EnergyBalanceComposite.tau"/>
            <input id="elevation" source="EnergyBalanceComposite.elevation"/>
            <input id="stefanBoltzman" source="EnergyBalanceComposite.stefanBoltzman"/>
            <input id="albedoCoefficientCan" source="EnergyBalanceComposite.albedoCoefficientCan"/>
            <output id="netOutGoingLongWaveRadiation" destination="EnergyBalanceComposite.netOutGoingLongWaveRadiation"/></simcomponent>
        <simcomponent id="Conductance" class="net.simplace.sim.components.SiriusQuality-EnergyBalance_Original.Conductance">
            <input id="d" source="EnergyBalanceComposite.d"/>
            <input id="heightWeatherMeasurements" source="EnergyBalanceComposite.heightWeatherMeasurements"/>
            <input id="plantHeight" source="EnergyBalanceComposite.plantHeight"/>
            <input id="zh" source="EnergyBalanceComposite.zh"/>
            <input id="zm" source="EnergyBalanceComposite.zm"/>
            <input id="vonKarman" source="EnergyBalanceComposite.vonKarman"/>
            <input id="ih" source="EnergyBalanceComposite.ih"/>
            <input id="wind" source="EnergyBalanceComposite.wind"/>
            <output id="conductance" destination="EnergyBalanceComposite.conductance"/></simcomponent>
        <simcomponent id="DiffusionLimitedEvaporation" class="net.simplace.sim.components.SiriusQuality-EnergyBalance_Original.DiffusionLimitedEvaporation">
            <input id="ih" source="EnergyBalanceComposite.ih"/>
            <input id="soilDiffusionConstant" source="EnergyBalanceComposite.soilDiffusionConstant"/>
            <input id="deficitOnTopLayers" source="EnergyBalanceComposite.deficitOnTopLayers"/>
            <output id="diffusionLimitedEvaporation" destination="EnergyBalanceComposite.diffusionLimitedEvaporation"/></simcomponent>
        <simcomponent id="NetRadiationEquivalentEvaporation" class="net.simplace.sim.components.SiriusQuality-EnergyBalance_Original.NetRadiationEquivalentEvaporation">
            <input id="lambdaV" source="EnergyBalanceComposite.lambdaV"/>
            <input id="netRadiation" source="NetRadiation.netRadiation"/></simcomponent>
        <simcomponent id="PriestlyTaylor" class="net.simplace.sim.components.SiriusQuality-EnergyBalance_Original.PriestlyTaylor">
            <input id="psychrometricConstant" source="EnergyBalanceComposite.psychrometricConstant"/>
            <input id="Alpha" source="EnergyBalanceComposite.Alpha"/>
            <input id="solarRadiation" source="EnergyBalanceComposite.solarRadiation"/>
            <input id="hslope" source="EnergyBalanceComposite.hslope"/>
            <input id="ih" source="EnergyBalanceComposite.ih"/>
            <input id="netRadiationEquivalentEvaporation" source="NetRadiationEquivalentEvaporation.netRadiationEquivalentEvaporation"/></simcomponent>
        <simcomponent id="PtSoil" class="net.simplace.sim.components.SiriusQuality-EnergyBalance_Original.PtSoil">
            <input id="tauAlpha" source="EnergyBalanceComposite.tauAlpha"/>
            <input id="Alpha" source="EnergyBalanceComposite.Alpha"/>
            <input id="tau" source="EnergyBalanceComposite.tau"/>
            <input id="ih" source="EnergyBalanceComposite.ih"/>
            <input id="evapoTranspirationPriestlyTaylor" source="PriestlyTaylor.evapoTranspirationPriestlyTaylor"/></simcomponent>
        <simcomponent id="Penman" class="net.simplace.sim.components.SiriusQuality-EnergyBalance_Original.Penman">
            <input id="VPDair" source="EnergyBalanceComposite.VPDair"/>
            <input id="specificHeatCapacityAir" source="EnergyBalanceComposite.specificHeatCapacityAir"/>
            <input id="psychrometricConstant" source="EnergyBalanceComposite.psychrometricConstant"/>
            <input id="rhoDensityAir" source="EnergyBalanceComposite.rhoDensityAir"/>
            <input id="Alpha" source="EnergyBalanceComposite.Alpha"/>
            <input id="lambdaV" source="EnergyBalanceComposite.lambdaV"/>
            <input id="hslope" source="EnergyBalanceComposite.hslope"/>
            <input id="evapoTranspirationPriestlyTaylor" source="PriestlyTaylor.evapoTranspirationPriestlyTaylor"/>
            <input id="conductance" source="Conductance.conductance"/></simcomponent>
        <simcomponent id="SoilEvaporation" class="net.simplace.sim.components.SiriusQuality-EnergyBalance_Original.SoilEvaporation">
            <input id="ih" source="EnergyBalanceComposite.ih"/>
            <input id="energyLimitedEvaporation" source="PtSoil.energyLimitedEvaporation"/>
            <input id="diffusionLimitedEvaporation" source="DiffusionLimitedEvaporation.diffusionLimitedEvaporation"/></simcomponent>
        <simcomponent id="EvapoTranspiration" class="net.simplace.sim.components.SiriusQuality-EnergyBalance_Original.EvapoTranspiration">
            <input id="isWindVpDefined" source="EnergyBalanceComposite.isWindVpDefined"/>
            <input id="evapoTranspirationPenman" source="Penman.evapoTranspirationPenman"/>
            <input id="evapoTranspirationPriestlyTaylor" source="PriestlyTaylor.evapoTranspirationPriestlyTaylor"/></simcomponent>
        <simcomponent id="SoilHeatFlux" class="net.simplace.sim.components.SiriusQuality-EnergyBalance_Original.SoilHeatFlux">
            <input id="ih" source="EnergyBalanceComposite.ih"/>
            <input id="solarRadiation" source="EnergyBalanceComposite.solarRadiation"/>
            <input id="tau" source="EnergyBalanceComposite.tau"/>
            <input id="soilEvaporation" source="SoilEvaporation.soilEvaporation"/>
            <input id="netRadiationEquivalentEvaporation" source="NetRadiationEquivalentEvaporation.netRadiationEquivalentEvaporation"/></simcomponent>
        <simcomponent id="PotentialTranspiration" class="net.simplace.sim.components.SiriusQuality-EnergyBalance_Original.PotentialTranspiration">
            <input id="tau" source="EnergyBalanceComposite.tau"/>
            <input id="evapoTranspiration" source="EvapoTranspiration.evapoTranspiration"/></simcomponent>
        <simcomponent id="CropHeatFlux" class="net.simplace.sim.components.SiriusQuality-EnergyBalance_Original.CropHeatFlux">
            <input id="ih" source="EnergyBalanceComposite.ih"/>
            <input id="netRadiationEquivalentEvaporation" source="NetRadiationEquivalentEvaporation.netRadiationEquivalentEvaporation"/>
            <input id="soilHeatFlux" source="SoilHeatFlux.soilHeatFlux"/>
            <input id="potentialTranspiration" source="PotentialTranspiration.potentialTranspiration"/></simcomponent>
        <simcomponent id="CanopyTemperature" class="net.simplace.sim.components.SiriusQuality-EnergyBalance_Original.CanopyTemperature">
            <input id="specificHeatCapacityAir" source="EnergyBalanceComposite.specificHeatCapacityAir"/>
            <input id="maxTair" source="EnergyBalanceComposite.maxTair"/>
            <input id="lambdaV" source="EnergyBalanceComposite.lambdaV"/>
            <input id="minTair" source="EnergyBalanceComposite.minTair"/>
            <input id="rhoDensityAir" source="EnergyBalanceComposite.rhoDensityAir"/>
            <input id="cropHeatFlux" source="CropHeatFlux.cropHeatFlux"/>
            <input id="conductance" source="Conductance.conductance"/>
            <output id="maxCanopyTemperature" destination="EnergyBalanceComposite.maxCanopyTemperature"/>
            <output id="minCanopyTemperature" destination="EnergyBalanceComposite.minCanopyTemperature"/></simcomponent></simgroup></configuration>