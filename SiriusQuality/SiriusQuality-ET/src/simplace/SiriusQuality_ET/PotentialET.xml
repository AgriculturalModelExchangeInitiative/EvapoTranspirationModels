<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration PUBLIC "-//SIMPLACE/DTD GRP 1.0//EN" "http://simplace.net/dtd/GroupComponent.dtd">
<configuration class="net.simplace.sim.components.SiriusQuality-ET.PotentialET">
    <simgroup>
        <simcomponent id="NetRadiation" class="net.simplace.sim.components.SiriusQuality-ET.NetRadiation">
            <input id="albedoCoefficient" source="PotentialET.albedoCoefficient"/>
            <input id="maxTair" source="PotentialET.maxTair"/>
            <input id="minTair" source="PotentialET.minTair"/>
            <input id="vaporPressure" source="PotentialET.vaporPressure"/>
            <input id="ih" source="PotentialET.ih"/>
            <input id="extraSolarRadiation" source="PotentialET.extraSolarRadiation"/>
            <input id="solarRadiation" source="PotentialET.solarRadiation"/>
            <input id="tau" source="PotentialET.tau"/>
            <input id="elevation" source="PotentialET.elevation"/>
            <input id="stefanBoltzman" source="PotentialET.stefanBoltzman"/>
            <input id="albedoCoefficientCan" source="PotentialET.albedoCoefficientCan"/>
            <output id="netOutGoingLongWaveRadiation" destination="PotentialET.netOutGoingLongWaveRadiation"/>
            <output id="netRadiation" destination="PotentialET.netRadiation"/></simcomponent>
        <simcomponent id="Conductance" class="net.simplace.sim.components.SiriusQuality-ET.Conductance">
            <input id="d" source="PotentialET.d"/>
            <input id="heightWeatherMeasurements" source="PotentialET.heightWeatherMeasurements"/>
            <input id="plantHeight" source="PotentialET.plantHeight"/>
            <input id="zh" source="PotentialET.zh"/>
            <input id="zm" source="PotentialET.zm"/>
            <input id="vonKarman" source="PotentialET.vonKarman"/>
            <input id="ih" source="PotentialET.ih"/>
            <input id="wind" source="PotentialET.wind"/>
            <output id="conductance" destination="PotentialET.conductance"/></simcomponent>
        <simcomponent id="NetRadiationEquivalentEvaporation" class="net.simplace.sim.components.SiriusQuality-ET.NetRadiationEquivalentEvaporation">
            <input id="lambdaV" source="PotentialET.lambdaV"/>
            <input id="netRadiation" source="NetRadiation.netRadiation"/></simcomponent>
        <simcomponent id="PriestlyTaylor" class="net.simplace.sim.components.SiriusQuality-ET.PriestlyTaylor">
            <input id="psychrometricConstant" source="PotentialET.psychrometricConstant"/>
            <input id="Alpha" source="PotentialET.Alpha"/>
            <input id="solarRadiation" source="PotentialET.solarRadiation"/>
            <input id="hslope" source="PotentialET.hslope"/>
            <input id="ih" source="PotentialET.ih"/>
            <input id="netRadiationEquivalentEvaporation" source="NetRadiationEquivalentEvaporation.netRadiationEquivalentEvaporation"/>
            <output id="evapoTranspirationPriestlyTaylor" destination="PotentialET.evapoTranspirationPriestlyTaylor"/></simcomponent>
        <simcomponent id="Penman" class="net.simplace.sim.components.SiriusQuality-ET.Penman">
            <input id="VPDair" source="PotentialET.VPDair"/>
            <input id="specificHeatCapacityAir" source="PotentialET.specificHeatCapacityAir"/>
            <input id="psychrometricConstant" source="PotentialET.psychrometricConstant"/>
            <input id="rhoDensityAir" source="PotentialET.rhoDensityAir"/>
            <input id="Alpha" source="PotentialET.Alpha"/>
            <input id="lambdaV" source="PotentialET.lambdaV"/>
            <input id="hslope" source="PotentialET.hslope"/>
            <input id="evapoTranspirationPriestlyTaylor" source="PriestlyTaylor.evapoTranspirationPriestlyTaylor"/>
            <input id="conductance" source="Conductance.conductance"/>
            <output id="evapoTranspirationPenman" destination="PotentialET.evapoTranspirationPenman"/></simcomponent></simgroup></configuration>