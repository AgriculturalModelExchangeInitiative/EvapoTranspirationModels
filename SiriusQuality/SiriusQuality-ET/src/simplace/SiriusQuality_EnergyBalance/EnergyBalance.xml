<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration PUBLIC "-//SIMPLACE/DTD GRP 1.0//EN" "http://simplace.net/dtd/GroupComponent.dtd">
<configuration class="net.simplace.sim.components.SiriusQuality-EnergyBalance.EnergyBalance">
    <simgroup>
        <simcomponent id="NetRadiation" class="net.simplace.sim.components.SiriusQuality-EnergyBalance.NetRadiation">
            <input id="albedoCoefficientCan" source="EnergyBalance.albedoCoefficientCan"/>
            <input id="vaporPressure" source="EnergyBalance.vaporPressure"/>
            <input id="stefanBoltzman" source="EnergyBalance.stefanBoltzman"/>
            <input id="maxTair" source="EnergyBalance.maxTair"/>
            <input id="solarRadiation" source="EnergyBalance.solarRadiation"/>
            <input id="ih" source="EnergyBalance.ih"/>
            <input id="minTair" source="EnergyBalance.minTair"/>
            <input id="extraSolarRadiation" source="EnergyBalance.extraSolarRadiation"/>
            <input id="tau" source="EnergyBalance.tau"/>
            <input id="elevation" source="EnergyBalance.elevation"/>
            <input id="albedoCoefficient" source="EnergyBalance.albedoCoefficient"/>
            <output id="netOutGoingLongWaveRadiation" destination="EnergyBalance.netOutGoingLongWaveRadiation"/></simcomponent>
        <simcomponent id="Conductance" class="net.simplace.sim.components.SiriusQuality-EnergyBalance.Conductance">
            <input id="ih" source="EnergyBalance.ih"/>
            <input id="wind" source="EnergyBalance.wind"/>
            <input id="heightWeatherMeasurements" source="EnergyBalance.heightWeatherMeasurements"/>
            <input id="vonKarman" source="EnergyBalance.vonKarman"/>
            <input id="plantHeight" source="EnergyBalance.plantHeight"/>
            <input id="zh" source="EnergyBalance.zh"/>
            <input id="zm" source="EnergyBalance.zm"/>
            <input id="d" source="EnergyBalance.d"/>
            <output id="conductance" destination="EnergyBalance.conductance"/></simcomponent>
        <simcomponent id="DiffusionLimitedEvaporation" class="net.simplace.sim.components.SiriusQuality-EnergyBalance.DiffusionLimitedEvaporation">
            <input id="soilDiffusionConstant" source="EnergyBalance.soilDiffusionConstant"/>
            <input id="ih" source="EnergyBalance.ih"/>
            <input id="deficitOnTopLayers" source="EnergyBalance.deficitOnTopLayers"/>
            <output id="diffusionLimitedEvaporation" destination="EnergyBalance.diffusionLimitedEvaporation"/></simcomponent>
        <simcomponent id="NetRadiationEquivalentEvaporation" class="net.simplace.sim.components.SiriusQuality-EnergyBalance.NetRadiationEquivalentEvaporation">
            <input id="lambdaV" source="EnergyBalance.lambdaV"/>
            <input id="netRadiation" source="NetRadiation.netRadiation"/></simcomponent>
        <simcomponent id="PriestlyTaylor" class="net.simplace.sim.components.SiriusQuality-EnergyBalance.PriestlyTaylor">
            <input id="ih" source="EnergyBalance.ih"/>
            <input id="psychrometricConstant" source="EnergyBalance.psychrometricConstant"/>
            <input id="Alpha" source="EnergyBalance.Alpha"/>
            <input id="hslope" source="EnergyBalance.hslope"/>
            <input id="solarRadiation" source="EnergyBalance.solarRadiation"/>
            <input id="netRadiationEquivalentEvaporation" source="NetRadiationEquivalentEvaporation.netRadiationEquivalentEvaporation"/></simcomponent>
        <simcomponent id="PtSoil" class="net.simplace.sim.components.SiriusQuality-EnergyBalance.PtSoil">
            <input id="ih" source="EnergyBalance.ih"/>
            <input id="Alpha" source="EnergyBalance.Alpha"/>
            <input id="tauAlpha" source="EnergyBalance.tauAlpha"/>
            <input id="tau" source="EnergyBalance.tau"/>
            <input id="evapoTranspirationPriestlyTaylor" source="PriestlyTaylor.evapoTranspirationPriestlyTaylor"/></simcomponent>
        <simcomponent id="Penman" class="net.simplace.sim.components.SiriusQuality-EnergyBalance.Penman">
            <input id="psychrometricConstant" source="EnergyBalance.psychrometricConstant"/>
            <input id="specificHeatCapacityAir" source="EnergyBalance.specificHeatCapacityAir"/>
            <input id="Alpha" source="EnergyBalance.Alpha"/>
            <input id="hslope" source="EnergyBalance.hslope"/>
            <input id="lambdaV" source="EnergyBalance.lambdaV"/>
            <input id="rhoDensityAir" source="EnergyBalance.rhoDensityAir"/>
            <input id="VPDair" source="EnergyBalance.VPDair"/>
            <input id="conductance" source="Conductance.conductance"/>
            <input id="evapoTranspirationPriestlyTaylor" source="PriestlyTaylor.evapoTranspirationPriestlyTaylor"/></simcomponent>
        <simcomponent id="SoilEvaporation" class="net.simplace.sim.components.SiriusQuality-EnergyBalance.SoilEvaporation">
            <input id="ih" source="EnergyBalance.ih"/>
            <input id="energyLimitedEvaporation" source="PtSoil.energyLimitedEvaporation"/>
            <input id="diffusionLimitedEvaporation" source="DiffusionLimitedEvaporation.diffusionLimitedEvaporation"/></simcomponent>
        <simcomponent id="EvapoTranspiration" class="net.simplace.sim.components.SiriusQuality-EnergyBalance.EvapoTranspiration">
            <input id="isWindVpDefined" source="EnergyBalance.isWindVpDefined"/>
            <input id="evapoTranspirationPenman" source="Penman.evapoTranspirationPenman"/>
            <input id="evapoTranspirationPriestlyTaylor" source="PriestlyTaylor.evapoTranspirationPriestlyTaylor"/></simcomponent>
        <simcomponent id="SoilHeatFlux" class="net.simplace.sim.components.SiriusQuality-EnergyBalance.SoilHeatFlux">
            <input id="ih" source="EnergyBalance.ih"/>
            <input id="tau" source="EnergyBalance.tau"/>
            <input id="solarRadiation" source="EnergyBalance.solarRadiation"/>
            <input id="netRadiationEquivalentEvaporation" source="NetRadiationEquivalentEvaporation.netRadiationEquivalentEvaporation"/>
            <input id="soilEvaporation" source="SoilEvaporation.soilEvaporation"/></simcomponent>
        <simcomponent id="PotentialTranspiration" class="net.simplace.sim.components.SiriusQuality-EnergyBalance.PotentialTranspiration">
            <input id="tau" source="EnergyBalance.tau"/>
            <input id="evapoTranspiration" source="EvapoTranspiration.evapoTranspiration"/></simcomponent>
        <simcomponent id="CropHeatFlux" class="net.simplace.sim.components.SiriusQuality-EnergyBalance.CropHeatFlux">
            <input id="ih" source="EnergyBalance.ih"/>
            <input id="potentialTranspiration" source="PotentialTranspiration.potentialTranspiration"/>
            <input id="netRadiationEquivalentEvaporation" source="NetRadiationEquivalentEvaporation.netRadiationEquivalentEvaporation"/>
            <input id="soilHeatFlux" source="SoilHeatFlux.soilHeatFlux"/></simcomponent>
        <simcomponent id="CanopyTemperature" class="net.simplace.sim.components.SiriusQuality-EnergyBalance.CanopyTemperature">
            <input id="minTair" source="EnergyBalance.minTair"/>
            <input id="specificHeatCapacityAir" source="EnergyBalance.specificHeatCapacityAir"/>
            <input id="lambdaV" source="EnergyBalance.lambdaV"/>
            <input id="rhoDensityAir" source="EnergyBalance.rhoDensityAir"/>
            <input id="maxTair" source="EnergyBalance.maxTair"/>
            <input id="cropHeatFlux" source="CropHeatFlux.cropHeatFlux"/>
            <input id="conductance" source="Conductance.conductance"/>
            <output id="maxCanopyTemperature" destination="EnergyBalance.maxCanopyTemperature"/>
            <output id="minCanopyTemperature" destination="EnergyBalance.minCanopyTemperature"/></simcomponent></simgroup></configuration>