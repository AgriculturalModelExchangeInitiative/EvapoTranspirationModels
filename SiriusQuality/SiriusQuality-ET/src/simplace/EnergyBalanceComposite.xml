<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration PUBLIC "-//SIMPLACE/DTD GRP 1.0//EN" "http://simplace.net/dtd/GroupComponent.dtd">
<configuration class="net.simplace.sim.components.SiriusQuality-ET.EnergyBalanceComposite">
    <simgroup>
        <simcomponent id="NetRadiation" class="net.simplace.sim.components.SiriusQuality-ET.NetRadiation">
            <input id="albedoCoefficient" source="EnergyBalanceComposite.albedoCoefficient"/>
            <input id="maxTair" source="EnergyBalanceComposite.maxTair"/>
            <input id="minTair" source="EnergyBalanceComposite.minTair"/>
            <input id="vaporPressure" source="EnergyBalanceComposite.vaporPressure"/>
            <input id="ih" source="EnergyBalanceComposite.ih"/>
            <input id="extraSolarRadiation" source="EnergyBalanceComposite.extraSolarRadiation"/>
            <input id="solarRadiation" source="EnergyBalanceComposite.solarRadiation"/>
            <input id="tau" source="EnergyBalanceComposite.tau"/>
            <input id="elevation" source="EnergyBalanceComposite.elevation"/>
            <input id="stefanBoltzman" source="EnergyBalanceComposite.stefanBoltzman"/>
            <input id="albedoCoefficientCan" source="EnergyBalanceComposite.albedoCoefficientCan"/>
            <output id="netOutGoingLongWaveRadiation" destination="EnergyBalanceComposite.netOutGoingLongWaveRadiation"/>
            <output id="netRadiation" destination="EnergyBalanceComposite.netRadiation"/></simcomponent>
        <simcomponent id="Conductance" class="net.simplace.sim.components.SiriusQuality-ET.Conductance">
            <input id="d" source="EnergyBalanceComposite.d"/>
            <input id="heightWeatherMeasurements" source="EnergyBalanceComposite.heightWeatherMeasurements"/>
            <input id="plantHeight" source="EnergyBalanceComposite.plantHeight"/>
            <input id="zh" source="EnergyBalanceComposite.zh"/>
            <input id="zm" source="EnergyBalanceComposite.zm"/>
            <input id="vonKarman" source="EnergyBalanceComposite.vonKarman"/>
            <input id="ih" source="EnergyBalanceComposite.ih"/>
            <input id="wind" source="EnergyBalanceComposite.wind"/>
            <output id="conductance" destination="EnergyBalanceComposite.conductance"/></simcomponent>
        <simcomponent id="NetRadiationEquivalentEvaporation" class="net.simplace.sim.components.SiriusQuality-ET.NetRadiationEquivalentEvaporation">
            <input id="lambdaV" source="EnergyBalanceComposite.lambdaV"/>
            <input id="netRadiation" source="NetRadiation.netRadiation"/></simcomponent>
        <simcomponent id="PriestlyTaylor" class="net.simplace.sim.components.SiriusQuality-ET.PriestlyTaylor">
            <input id="psychrometricConstant" source="EnergyBalanceComposite.psychrometricConstant"/>
            <input id="Alpha" source="EnergyBalanceComposite.Alpha"/>
            <input id="solarRadiation" source="EnergyBalanceComposite.solarRadiation"/>
            <input id="hslope" source="EnergyBalanceComposite.hslope"/>
            <input id="ih" source="EnergyBalanceComposite.ih"/>
            <input id="netRadiationEquivalentEvaporation" source="NetRadiationEquivalentEvaporation.netRadiationEquivalentEvaporation"/>
            <output id="evapoTranspirationPriestlyTaylor" destination="EnergyBalanceComposite.evapoTranspirationPriestlyTaylor"/></simcomponent>
        <simcomponent id="Penman" class="net.simplace.sim.components.SiriusQuality-ET.Penman">
            <input id="VPDair" source="EnergyBalanceComposite.VPDair"/>
            <input id="specificHeatCapacityAir" source="EnergyBalanceComposite.specificHeatCapacityAir"/>
            <input id="psychrometricConstant" source="EnergyBalanceComposite.psychrometricConstant"/>
            <input id="rhoDensityAir" source="EnergyBalanceComposite.rhoDensityAir"/>
            <input id="Alpha" source="EnergyBalanceComposite.Alpha"/>
            <input id="lambdaV" source="EnergyBalanceComposite.lambdaV"/>
            <input id="hslope" source="EnergyBalanceComposite.hslope"/>
            <input id="evapoTranspirationPriestlyTaylor" source="PriestlyTaylor.evapoTranspirationPriestlyTaylor"/>
            <input id="conductance" source="Conductance.conductance"/>
            <output id="evapoTranspirationPenman" destination="EnergyBalanceComposite.evapoTranspirationPenman"/></simcomponent></simgroup></configuration>