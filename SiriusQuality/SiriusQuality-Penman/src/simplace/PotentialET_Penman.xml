<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE configuration PUBLIC "-//SIMPLACE/DTD GRP 1.0//EN" "http://simplace.net/dtd/GroupComponent.dtd">
<configuration class="net.simplace.sim.components.SiriusQuality-Penman.PotentialET_Penman">
    <simgroup>
        <simcomponent id="PriestlyTaylor" class="net.simplace.sim.components.SiriusQuality-Penman.PriestlyTaylor">
            <input id="netRadiation" source="PotentialET_Penman.netRadiation"/>
            <input id="lambdaV" source="PotentialET_Penman.lambdaV"/>
            <input id="psychrometricConstant" source="PotentialET_Penman.psychrometricConstant"/>
            <input id="Alpha" source="PotentialET_Penman.Alpha"/>
            <input id="solarRadiation" source="PotentialET_Penman.solarRadiation"/>
            <input id="hslope" source="PotentialET_Penman.hslope"/>
            <input id="ih" source="PotentialET_Penman.ih"/></simcomponent>
        <simcomponent id="Penman" class="net.simplace.sim.components.SiriusQuality-Penman.Penman">
            <input id="VPDair" source="PotentialET_Penman.VPDair"/>
            <input id="specificHeatCapacityAir" source="PotentialET_Penman.specificHeatCapacityAir"/>
            <input id="psychrometricConstant" source="PotentialET_Penman.psychrometricConstant"/>
            <input id="rhoDensityAir" source="PotentialET_Penman.rhoDensityAir"/>
            <input id="Alpha" source="PotentialET_Penman.Alpha"/>
            <input id="lambdaV" source="PotentialET_Penman.lambdaV"/>
            <input id="hslope" source="PotentialET_Penman.hslope"/>
            <input id="conductance" source="PotentialET_Penman.conductance"/>
            <input id="evapoTranspirationPriestlyTaylor" source="PriestlyTaylor.evapoTranspirationPriestlyTaylor"/>
            <output id="evapoTranspirationPenman" destination="PotentialET_Penman.evapoTranspirationPenman"/></simcomponent></simgroup></configuration>