<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE ModelComposition PUBLIC " " "https://raw.githubusercontent.com/AgriculturalModelExchangeInitiative/crop2ml/master/ModelComposition.dtd">
<ModelComposition name="PotentialET_Penman" id="SiriusQuality_EnergyBalance.PotentialET_Penman" version="1.0" timestep="1">
    <Description>
        <Title>PotentialET Component</Title>
        <Authors>SQ</Authors>
        <Institution>INRAE</Institution>
        <Reference>None</Reference>
        <ExtendedDescription>https://pimlday26.sciencesconf.org/program?lang=en</ExtendedDescription>
        <ShortDescription>Potential ET (based on Penman and Priestly-Taylor)</ShortDescription></Description>
    <Composition>
        <Model name="PriestlyTaylor" id="SiriusQuality_EnergyBalance.PriestlyTaylor" filename="unit.PriestlyTaylor.xml"/>
        <Model name="Penman" id="SiriusQuality_EnergyBalance.Penman" filename="unit.Penman.xml"/>
        <Links>
			<InputLink target="PriestlyTaylor.netRadiation" source="netRadiation"/>
            <InputLink target="PriestlyTaylor.lambdaV" source="lambdaV"/>
            <InputLink target="PriestlyTaylor.psychrometricConstant" source="psychrometricConstant"/>
            <InputLink target="PriestlyTaylor.Alpha" source="Alpha"/>
            <InputLink target="PriestlyTaylor.solarRadiation" source="solarRadiation"/>
            <InputLink target="PriestlyTaylor.hslope" source="hslope"/>
            <InputLink target="PriestlyTaylor.ih" source="ih"/>
            <InputLink target="Penman.VPDair" source="VPDair"/>
            <InputLink target="Penman.specificHeatCapacityAir" source="specificHeatCapacityAir"/>
            <InputLink target="Penman.psychrometricConstant" source="psychrometricConstant"/>
            <InputLink target="Penman.rhoDensityAir" source="rhoDensityAir"/>
            <InputLink target="Penman.Alpha" source="Alpha"/>
            <InputLink target="Penman.lambdaV" source="lambdaV"/>
            <InputLink target="Penman.hslope" source="hslope"/>
			<InputLink target="Penman.conductance" source="conductance"/>
     
            <InternalLink target="Penman.evapoTranspirationPriestlyTaylor" source="PriestlyTaylor.evapoTranspirationPriestlyTaylor"/>
            <OutputLink target="evapoTranspirationPenman" source="Penman.evapoTranspirationPenman"/>

			</Links>
			</Composition>
			</ModelComposition>